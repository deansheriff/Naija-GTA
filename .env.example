# Set this in Coolify as a secret. Use a long random hexadecimal password.
# Compose passes this as a raw password; URL encoding is not required.
# Do not deploy this placeholder or commit your actual .env file.
POSTGRES_PASSWORD=replace-with-a-long-random-hex-password
# Optional owner console. Generate the hash locally with npm run owner:password in server/.
# Leave both owner fields blank to keep owner access disabled.
OWNER_USERNAME=
OWNER_PASSWORD_HASH=
PUBLIC_ORIGIN=
# Only actual directly trusted proxy IPs/CIDRs. Leave blank to ignore forwarded headers.
TRUSTED_PROXY_CIDRS=
