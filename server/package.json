{
  "name": "naija-street-life-server",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.17.0"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "check": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "test": "tsx --test test/*.test.ts",
    "owner:password": "tsx src/owner-password.ts",
    "maintenance": "node dist/maintenance.js"
  },
  "dependencies": {
    "@fastify/static": "10.1.6",
    "fastify": "5.12.5",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.9",
    "@types/node": "22.20.5",
    "@types/pg": "8.20.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
}
